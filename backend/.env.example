PORT=4000
CLIENT_URL=http://localhost:5173

# Convex deployment that stores all data (Nexus project: rakeshwfg/nexus, deployment curious-ram-94).
CONVEX_URL=https://curious-ram-94.convex.cloud
# Must equal the NEXUS_SERVER_SECRET environment variable set on that Convex deployment
# (npx convex env set NEXUS_SERVER_SECRET <value>). Keeps the data functions server-only.
NEXUS_SERVER_SECRET=

JWT_SECRET=change-me-in-production-supportdesk-secret
JWT_EXPIRES_IN=7d

# Optional SMTP for outgoing email (otherwise emails are only logged to the outbox)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
