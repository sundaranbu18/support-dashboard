{
  "name": "nexus-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:seed": "node src/db/seed.js && node src/db/seed-parity.js",
    "db:reset": "node src/db/reset.js --yes && node src/db/seed.js && node src/db/seed-parity.js",
    "convex:push": "convex dev --once",
    "db:import-postgres": "node scripts/import-from-postgres.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "convex": "^1.50.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "pg": "^8.12.0"
  }
}
